# ==============================================================================
# GTNIC Cybersecurity AI Agent - Professional Modular Monolith .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# ------------------------------------------------------------------------------
# Production Builds & Bundler Outputs (Next.js, Webpack, Turbopack, Vite)
# ------------------------------------------------------------------------------
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit API keys or credentials)
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example
!.env.template

# ------------------------------------------------------------------------------
# Logs & Telemetry
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.turbo/
**/.turbo/

# ------------------------------------------------------------------------------
# Python & AI/ML Backend Environments (Modular Monolith Readiness)
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# Operating System & Filesystem Junk
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.fleet/

# ------------------------------------------------------------------------------
# Temporary Files & Dumps
# ------------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.swp
*.patch

*.log
nginx-logs/
