# -----------------------------------------------------------------------------
# GTNIC Autonomous SOC Agent - Frontend Environment Configuration
# -----------------------------------------------------------------------------

# Next.js Port (Default: 3000)
PORT=3000

# Server-only key: match DASHBOARD_API_KEY in the backend environment.
# Set this in frontend/.env.local and in Vercel Environment Variables.
# Never prefix this key with NEXT_PUBLIC_.
DASHBOARD_API_KEY=

# SWR Polling Interval (in milliseconds)
NEXT_PUBLIC_POLL_INTERVAL_MS=3000
