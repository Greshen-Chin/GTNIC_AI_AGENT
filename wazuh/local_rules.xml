<group name="web,juiceshop,">
  <rule id="100100" level="3">
    <if_sid>31100</if_sid>
    <id>^401</id>
    <url>/rest/user/login</url>
    <description>JuiceShop: login gagal</description>
  </rule>
  <rule id="100103" level="3">
    <if_sid>31100</if_sid>
    <id>200</id>
    <url>^/rest/user/login</url>
    <description>Juice Shop: login berhasil</description>
  </rule>
  <rule id="100102" level="5" frequency="3" timeframe="120">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>Juice Shop: 3 login gagal dalam 2 menit (mungkin salah ketik)</description>
  </rule>
  <rule id="100101" level="10" frequency="8" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>Juice Shop: brute force login</description>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100110" level="8">
    <if_sid>31100</if_sid>
    <url type="pcre2">(?i)(%27|')(%20|\+)*or(%20|\+)|union(%20|\+)+select|(%27|')--</url>
    <description>Juice Shop: pola SQL injection pada URL</description>
    <mitre><id>T1190</id></mitre>
  </rule>
  <rule id="100111" level="8">
    <if_sid>31100</if_sid>
    <field name="body" type="pcre2">(?i)(%27|')(%20|\+)*or(%20|\+)|union(%20|\+)+select|(%27|')--|or\s+\w+=\w+</field>
    <description>Juice Shop: pola SQL injection pada Request Body</description>
    <mitre><id>T1190</id></mitre>
  </rule>
</group>

